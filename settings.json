{
  "permissions": {
    "allow": [
      "Bash",
      "Grep",
      "Glob",
      "Read",
      "Task",
      "BashOutput",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash:rm"
    ]
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "model": "opus[1m]"
}
